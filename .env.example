# Optional LLM enhancement layer (Phase D).
#
# The recommendation engine is FULLY FUNCTIONAL without any of this. The LLM
# only (a) helps interpret free-text when the deterministic normalizer can't,
# and (b) rephrases already-retrieved knowledge into warmer prose. It never
# chooses a remedy, overrides safety, or invents facts.
#
# If LLM_PROVIDER is unset, the app runs deterministically and the UI is
# identical minus the rephrased prose. Copy this file to `.env` and fill in to
# enable it. `.env` is git-ignored. These are read SERVER-SIDE ONLY (in api/)
# and never reach the browser bundle.

# Which provider /api/recommend uses. Supported: "anthropic" | "nvidia".
# Leave blank to run without the LLM layer.
LLM_PROVIDER=

# Provider API key. Sent server-side only:
#   anthropic → x-api-key header      (Anthropic Messages API)
#   nvidia    → Authorization: Bearer (NVIDIA NIM, integrate.api.nvidia.com)
LLM_API_KEY=

# Optional model override. Defaults per provider:
#   anthropic → claude-haiku-4-5
#   nvidia    → nvidia/nemotron-3.5-lightning-30b-a3b
# Keep it small and fast — this only extracts symptom hints and rephrases
# already-retrieved facts; it never chooses a remedy.
LLM_MODEL=

# Per-call timeout in ms (default 8000, clamped 1000–20000). Applies to every
# provider.
LLM_TIMEOUT_MS=


# ---------------------------------------------------------------------------
# Contact form (src/components/Contact, api/contact.ts).
#
# The form is inert without these — a submission returns "Unable to send right
# now." and the visitor is pointed at the mailto link. All three are read
# SERVER-SIDE ONLY (in api/) and never reach the browser bundle. Set them in
# `.env` for local dev and in the Vercel project's Environment Variables for
# production.
# ---------------------------------------------------------------------------

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact messages are delivered.
CONTACT_EMAIL=mukuknegi2005@gmail.com

# The verified sender the mail is sent as — must be an address on a domain
# verified with Resend. The visitor's own address cannot go here (SPF/DKIM
# would fail); it is set as Reply-To instead. Resend's shared sender works for
# testing:
EMAIL_FROM=Sattva <onboarding@resend.dev>
